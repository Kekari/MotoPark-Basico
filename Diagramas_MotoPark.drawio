        <mxCell id="todas" value="Consultar auditoría de todos los usuarios" style="ellipse;whiteSpace=wrap;html=0;fontSize=16;fillColor=#FFFFFF;strokeColor=#3D6489;fontColor=#172B4D;strokeWidth=1.5;" vertex="1" parent="1">
