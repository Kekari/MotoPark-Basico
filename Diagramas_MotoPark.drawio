        </mxCell>
        <mxCell id="u-salir" value="" style="edgeStyle=none;html=0;endArrow=none;startArrow=none;strokeColor=#52657A;strokeWidth=1.3;fontSize=13;" edge="1" parent="1" source="usuario" target="salir">
          <mxGeometry relative="1" as="geometry" />
