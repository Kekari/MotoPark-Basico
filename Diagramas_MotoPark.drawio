          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auditoria" value="Consultar auditoría propia del día" style="ellipse;whiteSpace=wrap;html=0;fontSize=16;fillColor=#FFFFFF;strokeColor=#3D6489;fontColor=#172B4D;strokeWidth=1.5;" vertex="1" parent="1">
